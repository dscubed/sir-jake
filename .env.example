# Copy to .env and fill in. Never commit .env.

# "fake" keeps applications in memory (no Notion needed); "notion" writes to Notion.
# Defaults to "notion" in production and "fake" everywhere else.
APPLICANT_REPO=fake

# Notion internal integration (needed when APPLICANT_REPO=notion).
NOTION_TOKEN=
# Real 2027 S1 Applications database. Used only when VERCEL_ENV=production.
NOTION_DATA_SOURCE_ID=
# TEST Applications database. Used everywhere else, including locally.
NOTION_TEST_DATA_SOURCE_ID=

# Cloudflare Turnstile. These are Cloudflare's public always-pass test keys for local development.
# Always-fail test keys: secret 2x0000000000000000000000000000000AA, site 2x00000000000000000000AB.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: pretend it's this time, to test the open and closed states. Ignored in production.
# FAKE_NOW=2027-03-01T12:00:00+11:00
